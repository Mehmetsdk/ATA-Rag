# Scraper
BASE_URL=https://akademiata.pl

# Backend / RAG (Kişi 2)
# Leave DATABASE_URL unset to use backend/data/atarag.sqlite (ChatRepository / SQLite).
# Example: DATABASE_URL=sqlite:///C:/path/to/atarag.sqlite
# postgresql://… is reserved for the future RAG stack (not used by ChatRepository yet).
DATABASE_URL=
OPENAI_API_KEY=

# Frontend (Kişi 3)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=true
